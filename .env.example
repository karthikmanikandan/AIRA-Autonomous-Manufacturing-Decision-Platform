# ============================================================
# AIRA — Autonomous Manufacturing Decision Platform
# Unified Environment Configuration Example
# ============================================================

# ---------- AI / LLM (Fireworks AI) ----------
FIREWORKS_API_KEY=
FIREWORKS_MODEL=accounts/fireworks/models/llama-v3p3-70b-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024
MAX_AGENT_ITERATIONS=3

# ---------- AMD Compute / ROCm ----------
AMD_CLOUD_ENDPOINT=
AMD_ROCM_VERSION=6.0

# ---------- Service URLs ----------
BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
MCP_SERVER_URL=http://localhost:8001/sse

# ---------- Supabase ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Auth ----------
JWT_SECRET=
AUTH_SECRET=

# ---------- Data Warehouse Adapter ----------
# Options: supabase | bigquery
DATA_WAREHOUSE_BACKEND=supabase

# ---------- Demo Credentials (PoC only) ----------
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
